# ---- Site ----
# Canonical origin, used by robots.txt, sitemap.xml, OpenAPI, and the API
# catalog. Set this on the deployed instance.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Twilio availability checking (optional) ----
# Without these, the availability UI explains how to enable it and makes no
# network calls. Create an account at https://www.twilio.com, then copy the
# Account SID + Auth Token from the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Agent API (optional) ----
# Required for /api/agent/*. Generate a key with: openssl rand -hex 32
VANITY_AGENT_API_KEY=
